  color: #a0a0a0;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 30rpx;
  display: block;
}

.launches-list {
  height: 600rpx;
  width: 100%;
}

/* 发射卡片 */
.launch-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
  border: 1rpx solid rgba(255, 255, 255, 0.1);
