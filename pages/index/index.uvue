  margin-bottom: 30rpx;
  display: block;
}

.retry-btn {
  background: #ff3b30;
  color: #ffffff;
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

/* 主内容区域 */
.content {
  padding: 0 30rpx 100rpx;
}

