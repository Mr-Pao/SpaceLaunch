  padding: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.launch-card:active {
  transform: translateY(5rpx);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.2);
}

