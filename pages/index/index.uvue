<template>
  <view class="container">
    <!-- 太空背景 -->
    <view class="space-bg">
      <view class="stars" v-for="n in 50" :key="n" :style="{ left: `${Math.random() * 100}%`, top: `${Math.random() * 100}%` }"></view>
      <view class="planets"></view>
    </view>
    
    <!-- 标题区域 -->
    <view class="header">
      <image class="logo" src="/static/logo.png"></image>
      <text class="title">太空发射任务</text>
      <text class="subtitle">探索宇宙的壮丽旅程</text>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading" v-if="loading && launches.length === 0">
      <view class="rocket-loading">
        <image class="rocket-icon" src="/static/logo.png" :style="{ transform: `translateY(${rocketY}px)` }"></image>
        <view class="flame"></view>
      </view>
      <text class="loading-text">准备发射...</text>
    </view>
    
    <!-- 错误状态 -->
    <view class="error" v-else-if="error">
      <view class="error-content">
        <text class="error-icon">⚠️</text>
        <text class="error-text">{{ error }}</text>
        <button class="retry-btn" @click="fetchLaunches">重新尝试</button>
      </view>
    </view>
    
    <!-- 数据显示 -->
    <view class="content" v-else>
      <view class="launches-container" v-if="launches.length > 0">
        <text class="total">共 {{ total }} 条发射任务</text>
        
        <scroll-view class="launches-list" scroll-y @scrolltolower="loadMore" :scroll-with-animation="true">
          <view class="launch-card" v-for="launch in launches" :key="launch.id">
            <!-- 发射卡片 -->
            <view class="card-header">
              <text class="mission-name">{{ launch.name }}</text>
              <view class="status-badge" :class="getStatusClass(launch.status?.name || '')">
                {{ launch.status?.abbrev || '未知' }}
              </view>
            </view>
            
            <view class="card-body">
              <view class="launch-details">
                <view class="detail-item">
                  <text class="detail-label">发射时间</text>
                  <text class="detail-value">{{ formatDate(launch.net) }}</text>
                </view>
                <view class="detail-item" v-if="launch.rocket?.configuration?.name">
                  <text class="detail-label">火箭型号</text>
                  <text class="detail-value">{{ launch.rocket.configuration.name }}</text>
                </view>
                <view class="detail-item" v-if="launch.pad?.name">
                  <text class="detail-label">发射地点</text>
                  <text class="detail-value">{{ launch.pad.name }}</text>
                </view>
              </view>
              
              <view class="card-description" v-if="launch.mission?.description">
                <text>{{ truncateText(launch.mission.description, 120) }}</text>
              </view>
            </view>
            
            <view class="card-footer">
              <text class="provider">{{ launch.launch_service_provider?.name || '未知机构' }}</text>
              <text class="date">最后更新: {{ formatDate(launch.last_updated) }}</text>
            </view>
          </view>
          
          <!-- 加载更多提示 -->
          <view class="load-more" v-if="loadingMore">
            <text class="load-more-text">加载中...</text>
          </view>
          
          <!-- 没有更多数据提示 -->
          <view class="no-more" v-if="!hasMore && launches.length > 0">
            <text class="no-more-text">没有更多数据了</text>
          </view>
        </scroll-view>
      </view>
      
      <!-- 无数据状态 -->
      <view class="no-data" v-else>
        <view class="no-data-content">
          <text class="no-data-icon">🚀</text>
          <text class="no-data-text">暂无发射数据</text>
          <button class="refresh-btn" @click="fetchLaunches">重新获取</button>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      launches: [],
      total: 0,
      loading: true,
      loadingMore: false,
      error: '',
      rocketY: 0, // 用于火箭动画
      animationInterval: null,
      currentPage: 1,
      pageSize: 5,
      hasMore: true
    }
  },
  onLoad() {
    this.startRocketAnimation();
    this.fetchLaunches();
  },
  onUnload() {
    // 清理动画
    if (this.animationInterval) {
      clearInterval(this.animationInterval);
    }
  },
  methods: {
    async fetchLaunches() {
      // 重置为第一页
      this.currentPage = 1;
      this.launches = [];
      this.hasMore = true;
      this.loading = true;
      this.error = '';
      
      try {
        const result = await uniCloud.callFunction({
          name: 'unionOp',
          data: {
            unionAction: 'queryLaunches',
            page: this.currentPage,
            size: this.pageSize
          }
        });
        
        if (result.result && result.result.success) {
          const cloudData = result.result.data;
          this.launches = cloudData.list || [];
          this.total = cloudData.total || 0;
          // 判断是否还有更多数据
          this.hasMore = this.launches.length < this.total;
        } else {
          this.error = result.result?.message || '获取数据失败';
        }
      } catch (error) {
        console.error('调用云函数失败:', error);
        this.error = '获取数据失败，请稍后重试';
      } finally {
        this.loading = false;
        // 停止火箭动画
        if (this.animationInterval) {
          clearInterval(this.animationInterval);
        }
      }
    },
    
    async loadMore() {
      // 如果没有更多数据或者正在加载中，则不执行加载
      if (!this.hasMore || this.loadingMore) {
        return;
      }
      
      this.loadingMore = true;
      this.currentPage++;
      
      try {
        const result = await uniCloud.callFunction({
          name: 'unionOp',
          data: {
            unionAction: 'queryLaunches',
            page: this.currentPage,
            size: this.pageSize
          }
        });
        
        if (result.result && result.result.success) {
          const newData = result.result.data.list || [];
          // 追加新数据
          this.launches = [...this.launches, ...newData];
          // 判断是否还有更多数据
          this.hasMore = this.launches.length < this.total;
        }
      } catch (error) {
        console.error('加载更多失败:', error);
        // 加载失败时回退页码
        this.currentPage--;
      } finally {
        this.loadingMore = false;
      }
    },
    
    // 火箭加载动画
    startRocketAnimation() {
      let direction = 1;
      this.animationInterval = setInterval(() => {
        this.rocketY += direction * 2;
        if (this.rocketY > 10 || this.rocketY < -10) {
          direction *= -1;
        }
      }, 50);
    },
    
    // 根据任务状态返回样式类名
    getStatusClass(status) {
      if (!status) return 'normal';
      const statusStr = String(status);
      if (statusStr.includes('Success')) return 'success';
      if (statusStr.includes('Failure')) return 'failure';
      if (statusStr.includes('TBD')) return 'pending';
      return 'normal';
    },
    
    // 格式化日期
    formatDate(dateString) {
      if (!dateString) return '';
      
      try {
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return '';
        
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        
        return `${year}-${month}-${day} ${hours}:${minutes}`;
      } catch (e) {
        return '';
      }
    },
    
    // 截断文本
    truncateText(text, maxLength) {
      if (!text) return '';
      return String(text).length > maxLength ? String(text).substring(0, maxLength) + '...' : String(text);
    }
  }
}
</script>

<style>
