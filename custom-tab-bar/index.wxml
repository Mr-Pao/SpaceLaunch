<view class="ctb-wrap">
	<view class="ctb-bar">
		<block wx:for="{{list}}" wx:for-index="idx" wx:key="pagePath">
			<!-- 审核模式隐藏「活动」tab：wx:if 不影响 wx:for 的 idx，
			     data-index 仍是原始索引，go() 和选中态都不用改 -->
			<view
				wx:if="{{idx !== 3 || !review}}"
				class="ctb-tab {{selected === idx ? 'ctb-on' : ''}}"
				data-index="{{idx}}"
				bindtap="go"
			>
				<image
					class="ctb-icon"
					src="{{selected === idx ? item.iconActive : item.icon}}"
					mode="aspectFit"
				></image>
				<text class="ctb-label">{{item.text}}</text>
			</view>
		</block>
	</view>
</view>
