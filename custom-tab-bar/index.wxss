/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	/* 中间鼓包要凸出胶囊，顶部得留够空间，否则会被容器裁掉 */
	padding-top: 30rpx;
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	/* 必须用不透明色：中间的圆要和它完全同色才能融成一体，
	   半透明的话两层叠加会变深，接缝一眼就看出来 */
	background: #141a26;
	border-radius: 56rpx;
	/* 描边用 inset 画在内侧，不会横穿中间的鼓包 */
	box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.06);
	/* drop-shadow 跟随「胶囊 + 鼓包」的整体轮廓投影；
	   box-shadow 只认矩形，中间那块凸起不会有影子 */
	filter: drop-shadow(0 10rpx 26rpx rgba(0, 0, 0, 0.55));
}

.ctb-tab {
	flex: 1;
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100%;
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #6b7891;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}

/* ---------- 中间「即将发射」的鼓包 ----------
 *
 * 做法：一个与胶囊完全同色的圆，绝对定位在中间、向上偏移。
 * 圆在胶囊内部的部分和底色一致 → 完全隐形；
 * 只有凸出胶囊顶边的那一小段弧线露出来 → 看起来就是胶囊中间鼓了一块。
 *
 * 关键前提是胶囊不透明 + 圆与它同色，否则接缝会露出来。
 */
.ctb-mid-bg {
	position: absolute;
	left: 50%;
	top: -26rpx;
	width: 130rpx;
	height: 130rpx;
	margin-left: -65rpx;
	border-radius: 50%;
	background: #141a26;
	z-index: 0;
}

.ctb-mid .ctb-icon {
	position: relative;
	z-index: 1;
	width: 52rpx;
	height: 52rpx;
}

.ctb-mid .ctb-label {
	position: relative;
	z-index: 1;
}

/* 鼓包本身不能变色（否则就是另一块色块，接缝立刻显形），
   选中态改用图标发光来表达 */
.ctb-mid.ctb-on .ctb-icon {
	filter: drop-shadow(0 0 10rpx rgba(56, 189, 248, 0.75));
}
