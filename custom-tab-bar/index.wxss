/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	/* 提亮底色并与页面背景(#0a0e17)/卡片(#141a26)拉开层次：渐变 + 亮描边 + 顶部高光 */
	background: linear-gradient(180deg, #232e44 0%, #182234 100%);
	border: 1rpx solid rgba(140, 180, 240, 0.22);
	border-radius: 56rpx;
	box-shadow:
		0 12rpx 40rpx rgba(0, 0, 0, 0.6),
		inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.ctb-tab {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: calc(100% - 16rpx);
	margin: 8rpx 10rpx;
	border-radius: 44rpx;
}

/* 选中项：淡蓝圆角底，和未选中拉开明显层次 */
.ctb-on {
	background: rgba(56, 189, 248, 0.16);
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #7c8aa5;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}
