/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	/* 三层写法：env() 在部分安卓内核里不被识别，会让整条 calc() 失效、
	   padding 归零甚至布局塌掉，所以先用裸值兜底，再让支持的机型覆盖 */
	padding-bottom: 12rpx;
	padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	/* 半透明毛玻璃：与星空背景区分开但不挡背景，去掉边框更轻盈 */
	background: rgba(30, 40, 60, 0.62);
	backdrop-filter: blur(20rpx);
	-webkit-backdrop-filter: blur(20rpx);
	border-radius: 56rpx;
	box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.5);
}

.ctb-tab {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: calc(100% - 16rpx);
	margin: 8rpx 10rpx;
	border-radius: 44rpx;
}

/* 选中项：淡蓝圆角底，和未选中拉开明显层次 */
.ctb-on {
	background: rgba(56, 189, 248, 0.16);
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #7c8aa5;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}
