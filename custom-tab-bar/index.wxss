/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	padding-top: 18rpx;
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	background: rgba(20, 26, 38, 0.94);
	border: 1rpx solid rgba(255, 255, 255, 0.07);
	border-radius: 56rpx;
	box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.45);
}

.ctb-tab {
	flex: 1;
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100%;
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #6b7891;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}

/* ---------- 中间「即将发射」凸起的圆按钮 ---------- */

/* 圆形背景绝对定位，不参与 flex 排布，5 等分的宽度不会被它挤乱 */
.ctb-mid-bg {
	position: absolute;
	left: 50%;
	top: -24rpx;
	width: 104rpx;
	height: 104rpx;
	margin-left: -52rpx;
	border-radius: 50%;
	background: rgba(56, 189, 248, 0.13);
	border: 1rpx solid rgba(56, 189, 248, 0.3);
	z-index: 0;
}

.ctb-mid .ctb-icon {
	position: relative;
	z-index: 1;
	width: 58rpx;
	height: 58rpx;
	/* 图标跟着圆形往上顶，标签位置不动 */
	margin-top: -16rpx;
}

.ctb-mid .ctb-label {
	position: relative;
	z-index: 1;
	margin-top: 4rpx;
}

.ctb-mid.ctb-on .ctb-mid-bg {
	background: rgba(56, 189, 248, 0.24);
	border-color: rgba(56, 189, 248, 0.65);
	box-shadow: 0 8rpx 26rpx rgba(56, 189, 248, 0.35);
}
