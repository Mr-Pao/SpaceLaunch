/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	padding-top: 18rpx;
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	background: rgba(20, 26, 38, 0.94);
	border: 1rpx solid rgba(255, 255, 255, 0.07);
	border-radius: 56rpx;
	box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.45);
}

.ctb-tab {
	flex: 1;
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100%;
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #6b7891;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}

/* ---------- 中间「即将发射」凸起的圆按钮 ---------- */

/* 圆形背景绝对定位，不参与 flex 排布，5 等分的宽度不会被它挤乱。
   用实心深色 + 阴影做出「从胶囊里长出来」的立体感 ——
   之前用半透明底 + 描边，看起来只是个圈套在图标上，和胶囊是两张皮 */
.ctb-mid-bg {
	position: absolute;
	left: 50%;
	top: -18rpx;
	width: 96rpx;
	height: 96rpx;
	margin-left: -48rpx;
	border-radius: 50%;
	background: #1a2333;
	border: 1rpx solid rgba(255, 255, 255, 0.09);
	box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.55);
	z-index: 0;
}

.ctb-mid .ctb-icon {
	position: relative;
	z-index: 1;
	width: 52rpx;
	height: 52rpx;
	/* 图标跟着圆形往上顶，标签位置不动 */
	margin-top: -12rpx;
}

.ctb-mid .ctb-label {
	position: relative;
	z-index: 1;
	margin-top: 10rpx;
}

.ctb-mid.ctb-on .ctb-mid-bg {
	background: #1e2c42;
	border-color: rgba(56, 189, 248, 0.5);
	box-shadow: 0 6rpx 24rpx rgba(56, 189, 248, 0.32);
}
