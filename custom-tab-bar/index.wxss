/* 外层透明，只让胶囊有底色，露出一圈页面背景形成浮动感 */
.ctb-wrap {
	padding: 8rpx 24rpx;
	padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
	background: transparent;
}

.ctb-bar {
	display: flex;
	align-items: center;
	height: 112rpx;
	background: rgba(20, 26, 38, 0.94);
	border: 1rpx solid rgba(255, 255, 255, 0.07);
	border-radius: 56rpx;
	box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.45);
}

.ctb-tab {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 100%;
}

.ctb-icon {
	width: 44rpx;
	height: 44rpx;
}

.ctb-label {
	margin-top: 2rpx;
	color: #6b7891;
	font-size: 20rpx;
	line-height: 1.4;
}

.ctb-on .ctb-label {
	color: #38bdf8;
	font-weight: 600;
}
