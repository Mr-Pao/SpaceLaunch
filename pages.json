{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
			"tui-(.*)": "@/components/thorui/tui-$1/tui-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "太空发射任务",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/upcoming/upcomingInfo",
			"style": {
				"navigationBarTitleText": "发射任务详情",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/previous/previous",
			"style": {
				"navigationBarTitleText": "已发射",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/previous/previousInfo",
			"style": {
				"navigationBarTitleText": "发射任务详情",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/event/event",
			"style": {
				"navigationBarTitleText": "活动",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/agencies/agencies",
			"style": {
				"navigationBarTitleText": "机构信息",
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		}
	],
	"tabBar": {
		"backgroundColor": "#222",
		"selectedColor": "#3978bb",
		"color": "#A0A0A0",
		"borderStyle": "black",
		"list": [
			{
				"text": "即将发射",
				"pagePath": "pages/index/index",
				"iconPath": "static/image/tabbar/huojian1.png",
				"selectedIconPath": "static/image/tabbar/huojian2.png"
			},
			{
				"text": "已发射",
				"pagePath": "pages/previous/previous",
				"iconPath": "static/image/tabbar/fashe1.png",
				"selectedIconPath": "static/image/tabbar/fashe2.png"
			},
			{
				"text": "活动",
				"pagePath": "pages/event/event",
				"iconPath": "static/image/tabbar/guanyu1.png",
				"selectedIconPath": "static/image/tabbar/guanyu2.png"
			}
		]
	},
	"globalStyle": {
		"backgroundColor": "#000000",
		"backgroundTextStyle": "light",
		"navigationBarBackgroundColor": "#000000",
		"navigationBarTitleText": "Space Launch",
		"navigationBarTextStyle": "white"
	},
	"uniIdRouter": {}
}
